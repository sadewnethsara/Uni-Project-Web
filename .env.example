# ==========================================
# Supabase Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Service Role Key (SERVER ONLY - Used for ETL pipelines, batch upserts, and administrative operations)
# WARNING: NEVER expose this key to browser client code!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# Google Gemini Generative AI Configuration
# ==========================================
GEMINI_API_KEY=your_google_gemini_api_key_here

# ==========================================
# Text.lk SMS Gateway Configuration
# ==========================================
TEXT_LK_API_TOKEN=your_text_lk_api_token_here

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
